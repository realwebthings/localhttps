#!/bin/bash
# localhttps — global CLI to serve any local port on a trusted HTTPS domain.
# Usage:
#   localhttps use <domain> [port] [--http2]   (port defaults to 3000, HTTP/1.1 unless --http2)
#   localhttps stop [domain]         (stop one domain, or all if omitted)
#   localhttps list

VERSION="0.0.17"

set -e

GREEN="\033[0;32m"
YELLOW="\033[1;33m"
RED="\033[0;31m"
NC="\033[0m"

log()   { echo -e "${GREEN}[✔] $1${NC}"; }
warn()  { echo -e "${YELLOW}[!] $1${NC}"; }
error() { echo -e "${RED}[✘] $1${NC}"; exit 1; }

STATE_DIR="$HOME/.localhttps"
CERT_DIR="$STATE_DIR/certs"
mkdir -p "$CERT_DIR"

OS="$(uname -s)"
case "$OS" in
  Darwin) PLATFORM="macos" ;;
  Linux)  PLATFORM="linux" ;;
  *)      error "Unsupported OS: $OS" ;;
esac

if [ "$PLATFORM" = "macos" ]; then
  NGINX_CONF_DIR="/opt/homebrew/etc/nginx/servers"
  [ -d "$NGINX_CONF_DIR" ] || NGINX_CONF_DIR="/usr/local/etc/nginx/servers"
else
  NGINX_CONF_DIR="/etc/nginx/sites-available"
  NGINX_ENABLED_DIR="/etc/nginx/sites-enabled"
fi

port_owner() {
  local port="$1"
  if [ "$PLATFORM" = "linux" ]; then
    sudo ss -tlnp 2>/dev/null | grep -E ":$port[[:space:]]" | grep -oE '"[^"]+"' | head -n1 | tr -d '"'
  else
    lsof -nP -iTCP:"$port" -sTCP:LISTEN 2>/dev/null | awk 'NR==2{print $1}'
  fi
}

ensure_port_free() {
  local port="$1"
  pgrep -x nginx &> /dev/null && return

  local owner
  owner=$(port_owner "$port")
  [ -z "$owner" ] && return
  [ "$owner" = "nginx" ] && return

  if [ "$owner" = "apache2" ] || [ "$owner" = "httpd" ]; then
    warn "$owner is using port $port, which nginx needs. Stopping $owner..."
    if [ "$PLATFORM" = "macos" ]; then
      sudo apachectl stop 2>/dev/null || true
      sudo launchctl unload -w /System/Library/LaunchDaemons/org.apache.httpd.plist 2>/dev/null || true
    else
      sudo systemctl stop "$owner" 2>/dev/null || true
      sudo systemctl disable "$owner" 2>/dev/null || true
    fi
    log "Stopped $owner"
    return
  fi

  local stop_hint="sudo systemctl stop $owner"
  [ "$PLATFORM" = "macos" ] && stop_hint="sudo apachectl stop"
  error "Port $port is already in use by '$owner', so nginx cannot start.\nFree it (e.g. $stop_hint) or move $owner to a different port, then retry: localhttps use ..."
}

fix_stale_root_pid() {
  [ "$PLATFORM" = "macos" ] || return 0
  local pid_file="/opt/homebrew/var/run/nginx.pid"
  [ -f "$pid_file" ] || pid_file="/usr/local/var/run/nginx.pid"
  [ -f "$pid_file" ] || return 0

  local owner
  owner=$(stat -f "%Su" "$pid_file" 2>/dev/null) || return 0
  [ "$owner" = "root" ] || return 0

  warn "nginx.pid is owned by root (stale from a previous root-run nginx); fixing so it can run as your user..."
  sudo launchctl bootout system/homebrew.mxcl.nginx 2>/dev/null || true
  brew services stop nginx 2>/dev/null || true
  sudo rm -f "$pid_file"
}

reload_nginx() {
  local nginx_test_cmd="sudo nginx"
  [ "$PLATFORM" = "macos" ] && nginx_test_cmd="nginx"

  fix_stale_root_pid

  local test_output
  if ! test_output=$($nginx_test_cmd -t 2>&1); then
    local missing_path culprit
    missing_path=$(echo "$test_output" | grep -oE '"[^"]+"' | head -n1 | tr -d '"')
    if [ -n "$missing_path" ]; then
      culprit=$(sudo grep -rl "$missing_path" "$NGINX_CONF_DIR" 2>/dev/null | head -n1)
    fi

    # Auto-heal: if the broken config is one of ours (a stale/corrupt
    # localhttps-*.conf left behind by a previous failed run, referencing a
    # cert/path that no longer exists), remove it and retest once rather
    # than leaving every domain blocked by one broken site.
    if [ -n "$culprit" ] && [[ "$(basename "$culprit")" == localhttps-*.conf ]]; then
      local culprit_domain
      culprit_domain=$(basename "$culprit" .conf)
      culprit_domain="${culprit_domain#localhttps-}"
      warn "Config for '$culprit_domain' references a missing file ($missing_path) and is blocking nginx for everyone. Removing it (rerun 'localhttps use $culprit_domain ...' if you still need it) and retrying..."
      local rm_cmd="sudo rm -f"
      [ "$PLATFORM" = "macos" ] && rm_cmd="rm -f"
      $rm_cmd "$culprit"
      if [ "$PLATFORM" = "linux" ]; then
        sudo rm -f "$NGINX_ENABLED_DIR/$(basename "$culprit")"
      fi
      test_output=$($nginx_test_cmd -t 2>&1) || true
    fi

    if ! $nginx_test_cmd -t &>/dev/null; then
      local hint=""
      if [ -n "$culprit" ]; then
        hint="\n\nLikely cause: $culprit references missing path $missing_path\nFix it, or if it's not needed: sudo rm $culprit\nThen retry: localhttps use ..."
      fi
      error "nginx config is broken, so nothing was (re)started:\n$test_output$hint"
    fi
  fi

  if [ "$PLATFORM" = "macos" ]; then
    if ! nginx -s reload 2>/dev/null; then
      ensure_port_free 80
      ensure_port_free 443
      if ! nginx 2>/dev/null && ! brew services restart nginx 2>/dev/null; then
        local owner80 owner443
        owner80=$(port_owner 80)
        owner443=$(port_owner 443)
        error "nginx failed to start, so nothing was (re)started.\nPort 80 owner: ${owner80:-none}. Port 443 owner: ${owner443:-none}.\nFree the port(s) and retry: localhttps use ..."
      fi
    fi
  else
    if pgrep -x nginx &> /dev/null; then
      sudo systemctl reload nginx 2>/dev/null || sudo service nginx reload 2>/dev/null || sudo nginx -s reload
    else
      ensure_port_free 80
      ensure_port_free 443
      sudo systemctl start nginx 2>/dev/null || sudo service nginx start 2>/dev/null || sudo nginx

      sleep 0.3
      if ! pgrep -x nginx &> /dev/null; then
        # First attempt failed. Diagnose the actual bind failure, auto-stop
        # whatever's squatting the port, and retry once before giving up.
        local start_err bad_port owner
        start_err=$(sudo journalctl -u nginx -n 20 --no-pager 2>/dev/null | grep -i "emerg\|bind()")
        bad_port=$(echo "$start_err" | grep -oE 'bind\(\) to [^ ]+:[0-9]+' | grep -oE '[0-9]+$' | head -n1)

        if [ -n "$bad_port" ]; then
          owner=$(port_owner "$bad_port")
          if [ -n "$owner" ] && [ "$owner" != "nginx" ]; then
            warn "nginx failed to start: port $bad_port is held by '$owner'. Stopping it and retrying..."
            sudo systemctl stop "$owner" 2>/dev/null || sudo service "$owner" stop 2>/dev/null || true
            sudo systemctl disable "$owner" 2>/dev/null || true
            sudo systemctl start nginx 2>/dev/null || sudo service nginx start 2>/dev/null || sudo nginx || true
            sleep 0.3
          fi
        fi

        if ! pgrep -x nginx &> /dev/null; then
          start_err=$(sudo journalctl -u nginx -n 20 --no-pager 2>/dev/null | grep -i "emerg\|bind()")
          local hint=""
          if [ -n "$bad_port" ]; then
            owner=$(port_owner "$bad_port")
            hint="\n\nPort $bad_port is in use by '${owner:-another process}'. Stop it (e.g. sudo systemctl stop $owner) or free the port, then retry: localhttps use ..."
          fi
          error "nginx failed to start, so nothing was (re)started:\n${start_err:-(no journalctl output available)}$hint"
        fi
      fi
    fi
  fi
}

ensure_mkcert() {
  command -v mkcert &> /dev/null && return
  log "Installing mkcert..."
  if [ "$PLATFORM" = "macos" ]; then
    command -v brew &> /dev/null || error "Homebrew required: https://brew.sh"
    brew install mkcert
  else
    if command -v apt &> /dev/null; then
      sudo apt install -y libnss3-tools
    else
      sudo dnf install -y nss-tools
    fi
    MKCERT_VERSION=$(curl -fsSL https://api.github.com/repos/FiloSottile/mkcert/releases/latest | grep '"tag_name"' | cut -d'"' -f4)
    curl -fsSL "https://github.com/FiloSottile/mkcert/releases/download/${MKCERT_VERSION}/mkcert-${MKCERT_VERSION}-linux-amd64" -o /tmp/mkcert
    chmod +x /tmp/mkcert
    sudo mv /tmp/mkcert /usr/local/bin/mkcert
  fi
  mkcert -install
}

ensure_nginx() {
  command -v nginx &> /dev/null && return
  log "Installing nginx..."
  if [ "$PLATFORM" = "macos" ]; then
    brew install nginx
  else
    if command -v apt &> /dev/null; then
      sudo apt install -y nginx
    else
      sudo dnf install -y nginx
    fi
  fi
}

ensure_hosts() {
  local domain="$1"
  grep -q "^127\.0\.0\.1[[:space:]]*$domain\$" /etc/hosts && return 0
  echo "127.0.0.1 $domain" | sudo tee -a /etc/hosts > /dev/null
  log "Added $domain to /etc/hosts"
}

remove_hosts() {
  local domain="$1"
  grep -q "^127\.0\.0\.1[[:space:]]*$domain\$" /etc/hosts || return 0
  grep -v "^127\.0\.0\.1[[:space:]]*$domain\$" /etc/hosts | sudo tee /etc/hosts.new > /dev/null
  sudo cp /etc/hosts.new /etc/hosts
  sudo rm -f /etc/hosts.new
  log "Removed $domain from /etc/hosts"
}

ensure_cert() {
  local domain="$1"
  if [ -f "$CERT_DIR/$domain.pem" ] && [ -f "$CERT_DIR/$domain-key.pem" ]; then
    return
  fi
  mkcert -cert-file "$CERT_DIR/$domain.pem" -key-file "$CERT_DIR/$domain-key.pem" "$domain"
  log "Certificate generated for $domain"
}

conf_path() {
  local domain="$1"
  if [ "$PLATFORM" = "macos" ]; then
    echo "$NGINX_CONF_DIR/localhttps-$domain.conf"
  else
    echo "$NGINX_CONF_DIR/localhttps-$domain.conf"
  fi
}

write_conf() {
  local domain="$1" port="$2" http2="$3"
  local conf; conf="$(conf_path "$domain")"
  local write_cmd="sudo tee"
  [ "$PLATFORM" = "macos" ] && write_cmd="tee"

  local listen_line="listen 443 ssl;"
  [ "$http2" = "1" ] && listen_line="listen 443 ssl http2;"

  $write_cmd "$conf" > /dev/null <<EOF
server {
    $listen_line
    server_name $domain;

    ssl_certificate     $CERT_DIR/$domain.pem;
    ssl_certificate_key $CERT_DIR/$domain-key.pem;

    location / {
        proxy_pass http://127.0.0.1:$port;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }
}
EOF

  if [ "$PLATFORM" = "linux" ]; then
    sudo mkdir -p "$NGINX_ENABLED_DIR"
    local link="$NGINX_ENABLED_DIR/localhttps-$domain.conf"
    # Recreate if missing, or if it's a stale symlink pointing elsewhere/nowhere.
    if [ ! -e "$link" ] || [ "$(readlink "$link" 2>/dev/null)" != "$conf" ]; then
      sudo ln -sf "$conf" "$link"
    fi
  fi
}

cmd_use() {
  local domain="" port="3000" http2=0 positional=()

  for arg in "$@"; do
    case "$arg" in
      --http2) http2=1 ;;
      *)       positional+=("$arg") ;;
    esac
  done

  domain="${positional[0]}"
  [ -n "${positional[1]:-}" ] && port="${positional[1]}"

  [ -z "$domain" ] && error "Usage: localhttps use <domain> [port] [--http2]"

  ensure_mkcert
  ensure_nginx
  ensure_hosts "$domain"
  ensure_cert "$domain"
  write_conf "$domain" "$port" "$http2"
  reload_nginx

  echo "$domain" >> "$STATE_DIR/active_domains"
  sort -u -o "$STATE_DIR/active_domains" "$STATE_DIR/active_domains"

  log "Serving https://$domain -> http://127.0.0.1:$port"
}

cmd_stop() {
  local domain="$1"
  local domains_to_stop=()

  if [ -n "$domain" ]; then
    domains_to_stop=("$domain")
  elif [ -f "$STATE_DIR/active_domains" ]; then
    while IFS= read -r d; do domains_to_stop+=("$d"); done < "$STATE_DIR/active_domains"
  fi

  [ "${#domains_to_stop[@]}" -eq 0 ] && { warn "No active domains to stop."; return; }

  for d in "${domains_to_stop[@]}"; do
    local conf; conf="$(conf_path "$d")"
    if [ "$PLATFORM" = "macos" ]; then
      rm -f "$conf"
    else
      sudo rm -f "$conf" "$NGINX_ENABLED_DIR/localhttps-$d.conf"
    fi
    remove_hosts "$d"
    if [ -f "$STATE_DIR/active_domains" ]; then
      grep -v -x "$d" "$STATE_DIR/active_domains" > "$STATE_DIR/active_domains.tmp" || true
      mv "$STATE_DIR/active_domains.tmp" "$STATE_DIR/active_domains"
    fi
    log "Stopped $d"
  done

  reload_nginx
}

cmd_list() {
  [ -f "$STATE_DIR/active_domains" ] || { echo "No active domains."; return; }
  while IFS= read -r d; do
    local conf; conf="$(conf_path "$d")"
    local port cat_cmd="cat"
    [ "$PLATFORM" = "linux" ] && cat_cmd="sudo cat"
    port=$($cat_cmd "$conf" 2>/dev/null | grep -oE 'proxy_pass http://127\.0\.0\.1:[0-9]+' | grep -oE '[0-9]+$')
    if [ -n "$port" ]; then
      echo "$d -> :$port"
    else
      echo "$d"
    fi
  done < "$STATE_DIR/active_domains"
}

cmd_update() {
  local link dest
  link=$(command -v localhttps) || error "localhttps not found on PATH"
  dest=$(readlink -f "$link" 2>/dev/null)
  [ -n "$dest" ] || dest="$link"
  local tmp="$STATE_DIR/localhttps.new"
  curl -fsSL "https://raw.githubusercontent.com/realwebthings/localhttps/main/bin/localhttps" -o "$tmp"
  chmod +x "$tmp"

  local new_version
  new_version=$(grep -m1 '^VERSION=' "$tmp" | cut -d'"' -f2)

  if [ "$new_version" = "$VERSION" ]; then
    rm -f "$tmp"
    log "Already up to date (v$VERSION)"
    return
  fi

  mv "$tmp" "$dest"
  log "Updated $dest: v$VERSION -> v${new_version:-unknown}"
}

print_usage() {
  cat <<EOF
Usage: localhttps <command> [args]

Commands:
  use <domain> [port] [--http2]   Serve https://<domain> -> 127.0.0.1:port (default port 3000, HTTP/1.1 unless --http2)
  stop [domain]         Stop one domain, or all active domains if omitted
  list                  Show active domains and their ports
  update                Update localhttps to the latest version
  version                Show installed version
  help                  Show this help
EOF
}

case "$1" in
  use)         shift; cmd_use "$@" ;;
  stop)        shift; cmd_stop "$@" ;;
  list)        cmd_list ;;
  update)      cmd_update ;;
  version|-v|--version) echo "localhttps v$VERSION" ;;
  help|-h|--help|"") print_usage ;;
  *)           echo "Unknown command: $1"; echo ""; print_usage; exit 1 ;;
esac
